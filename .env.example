# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/telegram-channel?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Admin (comma-separated emails)
ADMIN_EMAILS=admin@example.com

# Cron secret (for Vercel cron authorization)
CRON_SECRET=your-cron-secret-key

# Subscription pricing (in paise - 99900 = ₹999)
SUBSCRIPTION_AMOUNT_PAISE=99900
SUBSCRIPTION_CURRENCY=INR
